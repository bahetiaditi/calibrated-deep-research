# Copy to .env and fill in. .env is gitignored — never commit real keys.
# All three tiers are free and require no credit card.

# Gemini (primary LLM) — https://aistudio.google.com/apikey
# Free tier is Flash / Flash-Lite only since 2026-04-01.
# Check your project's LIVE limits in the AI Studio rate-limit view before
# an eval run; quotas are per-project and change without notice.
GOOGLE_API_KEY=

# Groq (fallback LLM) — https://console.groq.com/keys
GROQ_API_KEY=

# Tavily (web search, primary during eval) — https://app.tavily.com
# 1000 credits/month. basic search = 1 credit, advanced = 2.
TAVILY_API_KEY=

# Optional: LangSmith tracing. The project ships its own JSONL tracer (C4)
# and does not depend on this. Leave blank unless you want the UI.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false