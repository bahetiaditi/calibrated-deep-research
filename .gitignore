# ---- secrets ----
.env
*.key

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ---- generated data ----
# Caches and indexes are reproducible; traces and results are NOT
# (they cost API quota). See the exceptions below.
# Everything under data/ is machine-local runtime state, not source.
# The quota ledger in particular MUST NOT be tracked: it records what this
# machine spent today. Committing it means a clone starts life believing it
# has already used someone else's quota, and every pull creates a conflict.
data/
*.joblib

# Traces are large and per-run. Keep the ones backing published numbers.
traces/*
!traces/.gitkeep
!traces/published/

# Results: commit the metric tables and figures, not the raw dumps.
results/*
!results/.gitkeep
!results/*.md
!results/*.csv
!results/*.png

# ---- os / editor ----
.DS_Store
.vscode/
.idea/